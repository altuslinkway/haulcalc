# Copy to .env.local and fill in.

# Required for real photo analysis. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Shared learning: a Postgres connection string (Vercel Postgres/Neon, Supabase, etc).
# Corrections from every owner are pooled here so estimates improve for everyone.
# Without it, learning stays on each device (in development it uses .data/feedback.json).
# DATABASE_URL=postgres://user:password@host/db

# Optional: try the app with sample answers and no API key (photos are ignored).
# HAULCALC_DEMO=1

# Optional overrides. Defaults: claude-opus-5-5 at medium effort.
# HAULCALC_MODEL=claude-opus-5-5
# HAULCALC_EFFORT=medium
